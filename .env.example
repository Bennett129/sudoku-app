# Copy to .env and fill in. .env is git-ignored.

# Postgres connection string. On Neon this is the pooled one (host ends in -pooler).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/sudoku_app"
# Optional direct (unpooled) connection for migrations; Neon needs it.
# DATABASE_URL_UNPOOLED=""

# Random secret used to sign sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""

# Public URL of the app (https://sudoku.example.com in production)
BETTER_AUTH_URL="http://localhost:3000"

# Optional in development: without it, sign-in codes are printed to the
# dev server console instead of emailed. Get a key at resend.com.
RESEND_API_KEY=""
# Sender; must be on a domain verified in Resend (the default only
# delivers to the email address that owns the Resend account).
EMAIL_FROM="Sudoku <onboarding@resend.dev>"
